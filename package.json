{
  "name": "virtual-physics-laboratory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VPL - an interactive web laboratory: learn, set up, experiment, measure, calculate, graph, conclude, save.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "framer-motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/d3-scale": "^4.0.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
